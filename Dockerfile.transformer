# Dockerfile.transformer – Guaranteed to build (Nov 2025)
FROM python:3.11-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy only requirements first (caching)
COPY requirements_transformer.txt ./requirements.txt

# === STEP 1: Install PyTorch + TorchVision + Torchaudio (CPU) the safe way ===
# We use pytorch's official CPU bundle – tiny index, no huge wheel download
RUN pip install --no-cache-dir --timeout=100 \
    torch==2.6.0+cpu torchvision==0.21.0+cpu torchaudio==2.6.0+cpu \
    --index-url https://download.pytorch.org/whl/cpu

# === STEP 2: Install the rest of the requirements ===
RUN pip install --no-cache-dir --timeout=100 \
    -r requirements.txt

# === STEP 3: Copy code ===
COPY transformer_service.py .

# Create model dir (volume will override it)
RUN mkdir -p /app/models/transformer

# Environment
ENV MODEL_PATH=/app/models/transformer/final_model
ENV LABEL_MAPPING_PATH=/app/models/transformer/label_mapping.json
ENV PYTHONUNBUFFERED=1

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

CMD ["python", "transformer_service.py"]